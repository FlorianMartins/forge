{
  "name": "forge",
  "displayName": "Forge",
  "description": "Assistant de code souverain pour VS Code — modèles locaux ou OpenRouter, anonymisation des données avant tout envoi, zéro télémétrie.",
  "version": "0.2.0",
  "publisher": "hivey",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlorianMartins/forge.git"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "copilot",
    "ai",
    "ollama",
    "openrouter",
    "local llm",
    "privacy",
    "self-hosted"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge",
          "title": "Forge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "forge": [
        {
          "id": "forge.chat",
          "name": "Discussion",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "forge.newSession",
        "title": "Nouvelle discussion",
        "category": "Forge",
        "icon": "$(add)"
      },
      {
        "command": "forge.askAboutSelection",
        "title": "Interroger la sélection",
        "category": "Forge"
      },
      {
        "command": "forge.showEgress",
        "title": "Aperçu des données sortantes",
        "category": "Forge"
      },
      {
        "command": "forge.showCosts",
        "title": "Coûts et budget",
        "category": "Forge"
      },
      {
        "command": "forge.toggleCompletions",
        "title": "Activer/désactiver la complétion inline",
        "category": "Forge"
      },
      {
        "command": "forge.setApiKey",
        "title": "Enregistrer une clé de fournisseur",
        "category": "Forge"
      },
      {
        "command": "forge.clearApiKey",
        "title": "Effacer une clé de fournisseur",
        "category": "Forge"
      },
      {
        "command": "forge.indexWorkspace",
        "title": "Réindexer l'espace de travail",
        "category": "Forge"
      },
      {
        "command": "forge.editSelection",
        "title": "Modifier la sélection avec l'IA",
        "category": "Forge",
        "icon": "$(sparkle)"
      },
      {
        "command": "forge.generateCommitMessage",
        "title": "Rédiger le message de commit",
        "category": "Forge",
        "icon": "$(sparkle)"
      },
      {
        "command": "forge.explainTerminalSelection",
        "title": "Expliquer la sortie du terminal",
        "category": "Forge"
      },
      {
        "command": "forge.openTerminal",
        "title": "Ouvrir Forge dans le terminal",
        "category": "Forge",
        "icon": "$(terminal)"
      },
      {
        "command": "forge.fixDiagnostic",
        "title": "Corriger ce problème",
        "category": "Forge"
      },
      {
        "command": "forge.explainDiagnostic",
        "title": "Expliquer ce problème",
        "category": "Forge"
      },
      {
        "command": "forge.showHistory",
        "title": "Historique des conversations",
        "category": "Forge",
        "icon": "$(history)"
      },
      {
        "command": "forge.showModels",
        "title": "Choisir le modèle (comparer les prix)",
        "category": "Forge",
        "icon": "$(sparkle)"
      },
      {
        "command": "forge.showPermissions",
        "title": "Permissions de l'agent",
        "category": "Forge",
        "icon": "$(shield)"
      },
      {
        "command": "forge.pickCompletionModel",
        "title": "Choisir le modèle de complétion",
        "category": "Forge"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "forge.newSession",
          "when": "view == forge.chat",
          "group": "navigation@1"
        },
        {
          "command": "forge.showHistory",
          "when": "view == forge.chat",
          "group": "navigation@2"
        },
        {
          "command": "forge.openTerminal",
          "when": "view == forge.chat",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "forge.askAboutSelection",
          "when": "editorHasSelection",
          "group": "forge@1"
        },
        {
          "command": "forge.editSelection",
          "when": "editorTextFocus",
          "group": "forge@2"
        }
      ],
      "scm/title": [
        {
          "command": "forge.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "terminal/context": [
        {
          "command": "forge.explainTerminalSelection",
          "group": "forge@1"
        }
      ],
      "commandPalette": [
        {
          "command": "forge.fixDiagnostic",
          "when": "false"
        },
        {
          "command": "forge.explainDiagnostic",
          "when": "false"
        },
        {
          "command": "forge.askWith",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "forge.editSelection",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "forge.askAboutSelection",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Forge",
      "properties": {
        "forge.chat.provider": {
          "type": "string",
          "enum": [
            "local",
            "openrouter",
            "openai-compatible",
            "anthropic"
          ],
          "default": "local",
          "markdownDescription": "Fournisseur du modèle de **discussion**. `local` = Ollama / LM Studio / llama.cpp sur votre machine ou votre serveur : aucune donnée ne quitte le réseau."
        },
        "forge.chat.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Identifiant du modèle de discussion."
        },
        "forge.completion.provider": {
          "type": "string",
          "enum": [
            "local",
            "openrouter",
            "openai-compatible",
            "off"
          ],
          "default": "local",
          "markdownDescription": "Fournisseur de la **complétion inline**. Garder `local` : c'est le poste de dépense n°1 chez les concurrents (une requête par frappe)."
        },
        "forge.completion.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Modèle de complétion (doit supporter le remplissage au milieu / FIM)."
        },
        "forge.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Proposer des complétions pendant la frappe."
        },
        "forge.completion.debounceMs": {
          "type": "number",
          "default": 220,
          "description": "Délai d'inactivité avant de demander une complétion."
        },
        "forge.completion.maxTokens": {
          "type": "number",
          "default": 128,
          "description": "Longueur maximale d'une complétion."
        },
        "forge.completion.multiline": {
          "type": "boolean",
          "default": true,
          "description": "Autoriser les complétions sur plusieurs lignes."
        },
        "forge.endpoints.local": {
          "type": "string",
          "default": "http://127.0.0.1:11434/v1",
          "description": "URL du serveur local compatible OpenAI (Ollama : .../v1, LM Studio : http://127.0.0.1:1234/v1, vLLM, llama.cpp…)."
        },
        "forge.endpoints.openaiCompatible": {
          "type": "string",
          "default": "",
          "description": "URL d'une passerelle interne compatible OpenAI (proxy d'entreprise, Azure, LiteLLM…)."
        },
        "forge.endpoints.openrouter": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "description": "URL de base OpenRouter."
        },
        "forge.endpoints.anthropic": {
          "type": "string",
          "default": "https://api.anthropic.com/v1",
          "description": "URL de base Anthropic."
        },
        "forge.privacy.redaction": {
          "type": "string",
          "enum": [
            "strict",
            "balanced",
            "off"
          ],
          "default": "strict",
          "markdownDescription": "Anonymisation avant tout envoi **distant** :\n- `strict` : secrets, identités, machines, chemins, URL internes, adresses IP — pseudonymisés de façon réversible.\n- `balanced` : secrets et identités seulement.\n- `off` : aucune (déconseillé, exige `privacy.allowUnredacted`)."
        },
        "forge.privacy.allowUnredacted": {
          "type": "boolean",
          "default": false,
          "description": "Autorise réellement le mode « off ». Sans cette case, « off » retombe sur « balanced »."
        },
        "forge.privacy.blockedGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.env*",
            "**/*.pem",
            "**/*.key",
            "**/*.p12",
            "**/id_rsa*",
            "**/secrets/**",
            "**/credentials*",
            "**/.aws/**",
            "**/.ssh/**"
          ],
          "description": "Fichiers qui ne partent JAMAIS vers un fournisseur distant, quoi qu'il arrive."
        },
        "forge.privacy.egressPolicy": {
          "type": "string",
          "enum": [
            "ask-once",
            "ask-always",
            "trust"
          ],
          "default": "ask-once",
          "description": "Confirmation avant le premier envoi distant d'une session (ask-once), avant chaque envoi (ask-always), ou jamais (trust)."
        },
        "forge.privacy.auditLog": {
          "type": "boolean",
          "default": true,
          "description": "Journaliser localement chaque envoi distant (horodatage, fournisseur, modèle, empreinte, jetons, coût). Aucun contenu."
        },
        "forge.budget.perRequestUsd": {
          "type": "number",
          "default": 0.25,
          "description": "Coût estimé maximal d'une requête distante. Au-delà, la requête est refusée."
        },
        "forge.budget.dailyUsd": {
          "type": "number",
          "default": 2,
          "description": "Plafond de dépense distante par jour. 0 = illimité."
        },
        "forge.context.maxTokens": {
          "type": "number",
          "default": 8000,
          "description": "Budget de contexte envoyé au modèle (carte du dépôt + extraits)."
        },
        "forge.context.repoMap": {
          "type": "boolean",
          "default": true,
          "description": "Joindre une carte des symboles du dépôt plutôt que des fichiers entiers."
        },
        "forge.privacy.customTerms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Mots propres à l'organisation à toujours remplacer avant un envoi distant : noms de clients, de projets, de marques internes."
        },
        "forge.escalation.policy": {
          "type": "string",
          "enum": [
            "never",
            "ask",
            "auto"
          ],
          "default": "ask",
          "markdownDescription": "Quand le modèle local ne suffit pas (contexte trop grand, question de diagnostic ou d'architecture) : `never` refuse, `ask` propose, `auto` bascule seul vers le modèle d'escalade."
        },
        "forge.escalation.provider": {
          "type": "string",
          "enum": [
            "openrouter",
            "openai-compatible",
            "anthropic"
          ],
          "default": "openrouter",
          "description": "Fournisseur utilisé lors d'une escalade."
        },
        "forge.escalation.model": {
          "type": "string",
          "default": "",
          "description": "Modèle d'escalade (vide = pas d'escalade possible)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs && node esbuild.mjs --tests && node --test dist-tests/",
    "package": "npx --yes @vscode/vsce@3 package --no-dependencies -o forge.vsix",
    "models": "node scripts/update-models.mjs",
    "models:check": "node scripts/update-models.mjs --check",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test:integration": "node esbuild.mjs && node esbuild.mjs --integration && node dist-integration/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "forge": "./dist/forge.js"
  }
}
