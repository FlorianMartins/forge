{
  "name": "forge",
  "displayName": "Forge",
  "description": "%extension.description%",
  "version": "0.3.0",
  "publisher": "hivey",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlorianMartins/forge.git"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "copilot",
    "ai",
    "chat",
    "agent",
    "ollama",
    "openrouter",
    "local llm",
    "privacy",
    "self-hosted",
    "code completion",
    "gdpr",
    "anthropic"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge",
          "title": "%container.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "forge": [
        {
          "id": "forge.chat",
          "name": "%view.chat.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "forge.newSession",
        "title": "%command.newSession.title%",
        "category": "Forge",
        "icon": "$(add)"
      },
      {
        "command": "forge.askAboutSelection",
        "title": "%command.askAboutSelection.title%",
        "category": "Forge"
      },
      {
        "command": "forge.showEgress",
        "title": "%command.showEgress.title%",
        "category": "Forge"
      },
      {
        "command": "forge.showCosts",
        "title": "%command.showCosts.title%",
        "category": "Forge"
      },
      {
        "command": "forge.toggleCompletions",
        "title": "%command.toggleCompletions.title%",
        "category": "Forge"
      },
      {
        "command": "forge.setApiKey",
        "title": "%command.setApiKey.title%",
        "category": "Forge"
      },
      {
        "command": "forge.clearApiKey",
        "title": "%command.clearApiKey.title%",
        "category": "Forge"
      },
      {
        "command": "forge.indexWorkspace",
        "title": "%command.indexWorkspace.title%",
        "category": "Forge"
      },
      {
        "command": "forge.editSelection",
        "title": "%command.editSelection.title%",
        "category": "Forge",
        "icon": "$(sparkle)"
      },
      {
        "command": "forge.generateCommitMessage",
        "title": "%command.generateCommitMessage.title%",
        "category": "Forge",
        "icon": "$(sparkle)"
      },
      {
        "command": "forge.explainTerminalSelection",
        "title": "%command.explainTerminalSelection.title%",
        "category": "Forge"
      },
      {
        "command": "forge.openTerminal",
        "title": "%command.openTerminal.title%",
        "category": "Forge",
        "icon": "$(terminal)"
      },
      {
        "command": "forge.fixDiagnostic",
        "title": "%command.fixDiagnostic.title%",
        "category": "Forge"
      },
      {
        "command": "forge.explainDiagnostic",
        "title": "%command.explainDiagnostic.title%",
        "category": "Forge"
      },
      {
        "command": "forge.showHistory",
        "title": "%command.showHistory.title%",
        "category": "Forge",
        "icon": "$(history)"
      },
      {
        "command": "forge.showModels",
        "title": "%command.showModels.title%",
        "category": "Forge",
        "icon": "$(sparkle)"
      },
      {
        "command": "forge.showPermissions",
        "title": "%command.showPermissions.title%",
        "category": "Forge",
        "icon": "$(shield)"
      },
      {
        "command": "forge.pickCompletionModel",
        "title": "%command.pickCompletionModel.title%",
        "category": "Forge"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "forge.newSession",
          "when": "view == forge.chat",
          "group": "navigation@1"
        },
        {
          "command": "forge.showHistory",
          "when": "view == forge.chat",
          "group": "navigation@2"
        },
        {
          "command": "forge.openTerminal",
          "when": "view == forge.chat",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "forge.askAboutSelection",
          "when": "editorHasSelection",
          "group": "forge@1"
        },
        {
          "command": "forge.editSelection",
          "when": "editorTextFocus",
          "group": "forge@2"
        }
      ],
      "scm/title": [
        {
          "command": "forge.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "terminal/context": [
        {
          "command": "forge.explainTerminalSelection",
          "group": "forge@1"
        }
      ],
      "commandPalette": [
        {
          "command": "forge.fixDiagnostic",
          "when": "false"
        },
        {
          "command": "forge.explainDiagnostic",
          "when": "false"
        },
        {
          "command": "forge.askWith",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "forge.editSelection",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "forge.askAboutSelection",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Forge",
      "properties": {
        "forge.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "fr"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "forge.chat.provider": {
          "type": "string",
          "enum": [
            "local",
            "openrouter",
            "openai-compatible",
            "anthropic"
          ],
          "default": "local",
          "markdownDescription": "%config.chat.provider%"
        },
        "forge.chat.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "%config.chat.model%"
        },
        "forge.completion.provider": {
          "type": "string",
          "enum": [
            "local",
            "openrouter",
            "openai-compatible",
            "off"
          ],
          "default": "local",
          "markdownDescription": "%config.completion.provider%"
        },
        "forge.completion.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "%config.completion.model%"
        },
        "forge.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.completion.enabled%"
        },
        "forge.completion.debounceMs": {
          "type": "number",
          "default": 220,
          "description": "%config.completion.debounceMs%"
        },
        "forge.completion.maxTokens": {
          "type": "number",
          "default": 128,
          "description": "%config.completion.maxTokens%"
        },
        "forge.completion.multiline": {
          "type": "boolean",
          "default": true,
          "description": "%config.completion.multiline%"
        },
        "forge.endpoints.local": {
          "type": "string",
          "default": "http://127.0.0.1:11434/v1",
          "description": "%config.endpoints.local%"
        },
        "forge.endpoints.openaiCompatible": {
          "type": "string",
          "default": "",
          "description": "%config.endpoints.openaiCompatible%"
        },
        "forge.endpoints.openrouter": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "description": "%config.endpoints.openrouter%"
        },
        "forge.endpoints.anthropic": {
          "type": "string",
          "default": "https://api.anthropic.com/v1",
          "description": "%config.endpoints.anthropic%"
        },
        "forge.privacy.redaction": {
          "type": "string",
          "enum": [
            "strict",
            "balanced",
            "off"
          ],
          "default": "strict",
          "markdownDescription": "%config.privacy.redaction%"
        },
        "forge.privacy.allowUnredacted": {
          "type": "boolean",
          "default": false,
          "description": "%config.privacy.allowUnredacted%"
        },
        "forge.privacy.blockedGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.env*",
            "**/*.pem",
            "**/*.key",
            "**/*.p12",
            "**/id_rsa*",
            "**/secrets/**",
            "**/credentials*",
            "**/.aws/**",
            "**/.ssh/**"
          ],
          "description": "%config.privacy.blockedGlobs%"
        },
        "forge.privacy.egressPolicy": {
          "type": "string",
          "enum": [
            "ask-once",
            "ask-always",
            "trust"
          ],
          "default": "ask-once",
          "description": "%config.privacy.egressPolicy%"
        },
        "forge.privacy.auditLog": {
          "type": "boolean",
          "default": true,
          "description": "%config.privacy.auditLog%"
        },
        "forge.budget.perRequestUsd": {
          "type": "number",
          "default": 0.25,
          "description": "%config.budget.perRequestUsd%"
        },
        "forge.budget.dailyUsd": {
          "type": "number",
          "default": 2,
          "description": "%config.budget.dailyUsd%"
        },
        "forge.context.maxTokens": {
          "type": "number",
          "default": 8000,
          "description": "%config.context.maxTokens%"
        },
        "forge.context.repoMap": {
          "type": "boolean",
          "default": true,
          "description": "%config.context.repoMap%"
        },
        "forge.privacy.customTerms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.privacy.customTerms%"
        },
        "forge.escalation.policy": {
          "type": "string",
          "enum": [
            "never",
            "ask",
            "auto"
          ],
          "default": "ask",
          "markdownDescription": "%config.escalation.policy%"
        },
        "forge.escalation.provider": {
          "type": "string",
          "enum": [
            "openrouter",
            "openai-compatible",
            "anthropic"
          ],
          "default": "openrouter",
          "description": "%config.escalation.provider%"
        },
        "forge.escalation.model": {
          "type": "string",
          "default": "",
          "description": "%config.escalation.model%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs && node esbuild.mjs --tests && node --test dist-tests/",
    "package": "npx --yes @vscode/vsce@3 package --no-dependencies -o forge.vsix",
    "models": "node scripts/update-models.mjs",
    "models:check": "node scripts/update-models.mjs --check",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test:integration": "node esbuild.mjs && node esbuild.mjs --integration && node dist-integration/runTest.js",
    "publish:vsce": "npx --yes @vscode/vsce@3 publish --no-dependencies",
    "publish:ovsx": "npx --yes ovsx publish forge.vsix"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "bin": {
    "forge": "./dist/forge.js"
  },
  "galleryBanner": {
    "color": "#181818",
    "theme": "dark"
  },
  "homepage": "https://github.com/FlorianMartins/forge#readme",
  "bugs": {
    "url": "https://github.com/FlorianMartins/forge/issues"
  },
  "qna": "https://github.com/FlorianMartins/forge/issues",
  "pricing": "Free",
  "badges": [
    {
      "url": "https://github.com/FlorianMartins/forge/actions/workflows/ci.yml/badge.svg",
      "href": "https://github.com/FlorianMartins/forge/actions/workflows/ci.yml",
      "description": "CI"
    }
  ]
}
